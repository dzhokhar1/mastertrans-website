# Живёт на сервере в /opt/stacks/mastertrans/.env (chmod 600).
# Секреты: openssl rand -hex 32

POSTGRES_USER=mastertrans
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mastertrans

# Пока нет публичного IP/домена — сайт слушает только localhost.
# Публичный запуск: HTTP_BIND=<IP>:80, HTTPS_BIND=<IP>:443, SITE_ADDRESS=<домен>
HTTP_BIND=127.0.0.1:8080
HTTPS_BIND=127.0.0.1:8443
SITE_ADDRESS=:80

# Приложение
INTEGRATION_API_KEY=change-me
INTEGRATION_HMAC_SECRET=change-me
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost:8080
