# Копировать в deploy/.env на сервере (chmod 600). Секреты: openssl rand -hex 32

POSTGRES_USER=mastertrans
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mastertrans

# ":80" пока нет домена; потом — доменное имя, Caddy выпустит сертификат сам
SITE_ADDRESS=:80
ACME_EMAIL=admin@example.com

# Приложение
INTEGRATION_API_KEY=change-me
INTEGRATION_HMAC_SECRET=change-me
BETTER_AUTH_SECRET=change-me
BETTER_AUTH_URL=http://localhost
