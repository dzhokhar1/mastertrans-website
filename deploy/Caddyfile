{
	servers {
		# TLS терминирует Caddy подписки и приходит к нам по site_net из
		# частной подсети. Доверяем его X-Forwarded-For, чтобы видеть
		# реальные IP посетителей в логах и в приложении.
		trusted_proxies static private_ranges
		# Порт только HTTP внутри Docker, HTTP/3 не рекламируем.
		protocols h1 h2
	}
}

:80 {
	encode zstd gzip

	# Журнал запросов в stdout (ротация — в compose); client_ip — реальный IP.
	log

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	@scan path_regexp (?i)(\.(env|ini|sql|bak|pem|key|php)$|/wp-|/\.git|/\.env)
	handle @scan {
		abort
	}

	handle {
		reverse_proxy app:3000
	}
}
